            },
            "on_end": [
              {
                "action": "BROADCAST_MESSAGE",
                "message": "&a[TEST] Step 2 on_end ran (must appear exactly ONCE)"
              }
            ]
          },
          {
            "step_id": "test_step_3_boss",
            "name": "Defeat the Test Boss",
            "on_start": [
              {
                "action": "BROADCAST_TITLE",
                "title": "&cStep 3/3",
