        "required_level": 1,
        "max_players": 4,
        "time_limit_seconds": 600,
        "steps": [
          {
            "step_id": "test_step_1_kill",
            "name": "Kill 5 Husks",
            "on_start": [
              {
                "action": "BROADCAST_TITLE",
                "title": "&eStep 1/3",
                "subtitle": "&7Kill 5 test husks"
              },
              {
                "action": "SUMMON_GROUP",
                "mob_id": "test_husk",
                "vanilla_type": "HUSK",
                "amount": 5,
                "radius": 3,
                "center": {
                  "x": 55,
                  "y": 91,
                  "z": -21
                },
                "delay_ticks": 60
              }
            ],
            "on_current": null,
            "goal": {
              "type": "KILL_MOBS",
              "target_mob_id": "test_husk",
              "target_count": 5,
              "display_text": "Kill test husks"
            },
            "on_end": [
              {
                "action": "BROADCAST_MESSAGE",
                "message": "&a[TEST] Step 1 on_end ran (must appear exactly ONCE)"
              }
            ]
          },
          {
            "step_id": "test_step_2_survive",
            "name": "Survive 10 seconds",
            "on_start": [
              {
                "action": "BROADCAST_TITLE",
                "title": "&eStep 2/3",
                "subtitle": "&7Survive 10 seconds"
              }
            ],
            "on_current": null,
