    {
      "definition_id": "dungeon_test_training",
      "version": 1,
      "kind": "Dungeon",
      "payload": {
        "display_name": "[TEST] Training Grounds",
        "description": "Short 3-step dungeon for testing the dungeon engine (Task.md R14, R24). Everything spawns around the ind_t0 spawn point (55, 91, -21).",
