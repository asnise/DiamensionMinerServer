# ============================================================
# Dimensional Miner - .gitignore
# Only tracking: DimensionalMinerCore, database, docs, web-console
# ============================================================

# Environment & OS
.env
.env.local
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*.lock
session.lock

# IDEs & Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------
# Local Paper Server & Maps (Excluded from repository)
# ------------------------------------------------------------
server/
Map/

# ------------------------------------------------------------
# DimensionalMinerCore (Java / Gradle Build Artifacts)
# ------------------------------------------------------------
.gradle/
DimensionalMinerCore/.gradle/
DimensionalMinerCore/build/
!DimensionalMinerCore/gradle/wrapper/gradle-wrapper.jar
*.class

# ------------------------------------------------------------
# web-console (Next.js & Node Dependencies / Build)
# ------------------------------------------------------------
web-console/node_modules/
web-console/.next/
web-console/out/
web-console/build/
web-console/coverage/
web-console/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*