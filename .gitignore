# ============================================================
# Dimensional Miner - .gitignore
# ============================================================

# General
.env
.env.local
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp

# IDEs & Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------
# web-console (Next.js & Node)
# ------------------------------------------------------------
node_modules/
.next/
out/
build/
coverage/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# ------------------------------------------------------------
# plugin (Java / Gradle)
# ------------------------------------------------------------
.gradle/
plugin/build/
!plugin/gradle/wrapper/gradle-wrapper.jar
*.class

# ------------------------------------------------------------
# server (PaperMC Server)
# ------------------------------------------------------------
server/server.jar
server/world/
server/world_nether/
server/world_the_end/
server/logs/
server/crash-reports/
server/plugins/*
!server/plugins/.gitkeep
server/cache/
server/libraries/
server/versions/
server/usercache.json
server/banned-ips.json
server/banned-players.json
server/ops.json
server/whitelist.json